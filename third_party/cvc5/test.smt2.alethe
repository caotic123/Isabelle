(set-logic AUFLIA)
(declare-sort A$ 0)
(declare-sort Nat$ 0)
(declare-sort Num$ 0)
(declare-sort A_tree$ 0)
(declare-fun l$ () A_tree$)
(declare-fun n$ () A$)
(declare-fun r$ () A_tree$)
(declare-fun et$ () A_tree$)
(declare-fun avl$ (A_tree$) Bool)
(declare-fun max$ (Nat$ Nat$) Nat$)
(declare-fun one$ () Nat$)
(declare-fun suc$ (Nat$) Nat$)
(declare-fun bit0$ (Num$) Num$)
(declare-fun one$a () Num$)
(declare-fun plus$ (Nat$ Nat$) Nat$)
(declare-fun height$ (A_tree$) Nat$)
(declare-fun numeral$ (Num$) Nat$)
(declare-fun mkt_bal_l$ (A$ A_tree$ A_tree$) A_tree$)
(assert (avl$ r$))
(assert (or (= (height$ l$) (height$ r$)) (or (= (height$ l$) (plus$ (height$ r$) one$)) (or (= (height$ r$) (plus$ (height$ l$) one$)) (= (height$ l$) (plus$ (height$ r$) (numeral$ (bit0$ one$a))))))))
(assert (forall ((?v0 Nat$) (?v1 Nat$)) (= (plus$ ?v0 (suc$ ?v1)) (suc$ (plus$ ?v0 ?v1)))))
(assert (= (avl$ et$) true))
(assert (forall ((?v0 A_tree$) (?v1 A_tree$) (?v2 A$)) (=> (and (avl$ ?v0) (and (avl$ ?v1) (not (= (height$ ?v0) (plus$ (height$ ?v1) (numeral$ (bit0$ one$a))))))) (= (height$ (mkt_bal_l$ ?v2 ?v0 ?v1)) (plus$ one$ (max$ (height$ ?v0) (height$ ?v1)))))))
(assert (not (=> (avl$ (mkt_bal_l$ n$ l$ r$)) (avl$ l$))))
(check-sat)