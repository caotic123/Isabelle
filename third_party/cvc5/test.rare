)
(declare-rule bv-ult-ones ((@n0 Int) (x1 (BitVec @n0)) (n1 Int) (w1 Int))
  :premises ((= n1 (- (int.pow2 w1) 1)))
  :args (x1 n1 w1)
  :conclusion (= (bvult x1 (@bv n1 w1)) (distinct x1 (@bv n1 w1)))
