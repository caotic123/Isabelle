  :args (xs1 s1 ys1 zs1)
  :conclusion (= ($singleton_elim (bvor xs1 ($singleton_elim (bvor s1 ys1)) zs1)) ($singleton_elim (bvor xs1 s1 ys1 zs1)))
)
