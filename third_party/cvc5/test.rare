  :premises ((= (+ 1 i1 m1) (@bvsize x1)) (= n1 0) (= w1 (@bvsize x1)))
  :args (x1 i1 m1 n1 w1)
  :conclusion (= (concat (extract i1 n1 x1) (@bv n1 m1)) (bvmul x1 (bvshl (@bv 1 w1) (@bv m1 w1))))
