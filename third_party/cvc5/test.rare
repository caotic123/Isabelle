(declare-rule bv-mult-slt-mult-1 ((@n0 Int) (@n1 Int) (@n2 Int) (x1 (BitVec @n0)) (y1 (BitVec @n1)) (a1 (BitVec @n2)) (n1 Int) (m1 Int) (tn1 Int) (an1 Int))
  :premises ((= tn1 (@bvsize x1)) (= an1 (@bvsize a1)))
  :args (x1 y1 a1 n1 m1 tn1 an1)
  :conclusion (= (let ((_let_1 (sign_extend m1 a1))) (bvslt (bvmul (sign_extend n1 y1) _let_1) (bvmul (sign_extend n1 x1) _let_1))) (let ((_let_1 (@bv 0 an1))) (and (not (= (bvsub y1 x1) (@bv 0 tn1))) (not (= a1 _let_1)) (= (bvslt y1 x1) (bvsgt a1 _let_1)))))
)
(declare-rule bv-mult-slt-mult-2 ((@n0 Int) (@n1 Int) (@n2 Int) (x1 (BitVec @n0)) (y1 (BitVec @n1)) (a1 (BitVec @n2)) (n1 Int) (m1 Int) (tn1 Int) (an1 Int))
  :premises ((= tn1 (@bvsize x1)) (= an1 (@bvsize a1)))
  :args (x1 y1 a1 n1 m1 tn1 an1)
  :conclusion (= (let ((_let_1 (sign_extend m1 a1))) (bvslt (bvmul (zero_extend n1 y1) _let_1) (bvmul (zero_extend n1 x1) _let_1))) (let ((_let_1 (@bv 0 an1))) (and (not (= (bvsub y1 x1) (@bv 0 tn1))) (not (= a1 _let_1)) (= (bvult y1 x1) (bvsgt a1 _let_1)))))
)
