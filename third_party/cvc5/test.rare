)
(declare-rule bool-or-and-distrib ((y1 Bool) (y2 Bool) (ys1 Bool :list) (zs1 Bool :list))
  :args (y1 y2 ys1 zs1)
  :conclusion (= ($singleton_elim (or (and y1 y2 ys1) zs1)) (and ($singleton_elim (or y1 zs1)) ($singleton_elim (or ($singleton_elim (and y2 ys1)) zs1))))
)
