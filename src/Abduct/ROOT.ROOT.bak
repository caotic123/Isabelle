session Abduct = HOL +
  options [document = false]
  directories
    "Test"
  theories
    "Test/TEST"
    "Test/TEST_benchmark"
    "Test/SIMPLE"

(* Session for loading abduction Mirabelle action - imports HOL.Mirabelle *)
session Abduct_Mirabelle in "Mirabelle" = HOL +
  options [document = false]
  theories
    Mirabelle_Abduct_Setup
    TEST_mirabelle
    AVL_mirabelle
    BST_mirabelle
    AFP_mirabelle

(* AFP Benchmark session - Multiple AFP theories *)
session Abduct_Benchmark in "Benchmark" = Abduct_Mirabelle +
  options [document = false]
  sessions
    "HOL-Library"
  theories
    SanityCheck
    AVL_Benchmark       
    BinomialHeap_Benchmark
    Huffman_Benchmark
    Floyd_Warshall_Benchmark
    List_Index_Benchmark

(* Long Benchmark session - Diverse AFP theories covering arithmetic, logic, and data structures *)
session Abduct_LongBenchmark in "LongBenchmark" = HOL +
  options [document = false]
  theories
    Long_Benchmark

(* AFP Evaluation session - ALL patched AFP theories for large-scale evaluation *)
(* Use num_afp_entries and goals_per_entry parameters to filter at runtime *)
session Abduct_AFP_Evaluation in "AFPEvaluation" = HOL +
  options [document = false, timeout = 86400]
  sessions
    "HOL-Library"
    "HOL-Analysis"
    "HOL-Algebra"
    "HOL-Data_Structures"
    "HOL-Computational_Algebra"
    "HOL-Probability"
    "HOL-Decision_Procs"
    "HOL-Number_Theory"
    "HOL-IMP"
    "HOL-Statespace"
    "HOL-Imperative_HOL"
  directories
    "AFP"
  theories
    AFP_Evaluation_Setup
    "AFP/ABY3_Protocols/Additive_Sharing"
    "AFP/ABY3_Protocols/Finite_Number_Type"
